 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; background-color: #fcfcfc; border: 1px solid #d1d5db; border-left: 6px solid #0f766e; padding: 12px 15px; border-radius: 6px;&quot;>&#xa;  &lt;h3 style=&quot;margin: 0 0 8px 0; color: #0f766e; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e5e7eb; padding-bottom: 5px;&quot;>&#xa;    ⚙️ Technical Parameters&#xa;  &lt;/h3>&#xa;  &lt;ul style=&quot;margin: 0; padding-left: 18px; font-size: 11.5px; line-height: 1.7; color: #374151;&quot;>&#xa;    &lt;li>&lt;b>Satellite:&lt;/b> Sentinel-2 (10m Multispectral)&lt;/li>&#xa;    &lt;li>&lt;b>Water Index:&lt;/b> NDWI &lt;span style=&quot;font-size: 10px; color: #666;&quot;>(Green - NIR) / (Green + NIR)&lt;/span>&lt;/li>&#xa;    &lt;li>&lt;b>Cloud Masking:&lt;/b> SCL (Scene Classification Layer)&lt;/li>&#xa;    &lt;li>&lt;b>CRS Projection:&lt;/b> EPSG:32646 (UTM Zone 46N)&lt;/li>&#xa;  &lt;/ul>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="6.70654,141.109,mm" positionLock="false" positionOnPage="6.70654,141.109,mm" referencePoint="0" size="97.2619,28.4345,mm" templateUuid="{a107cdd1-6df0-4431-8e82-f421086f58cc}" type="65641" uuid="{a107cdd1-6df0-4431-8e82-f421086f58cc}" valign="32" visibility="1" zValue="9">
