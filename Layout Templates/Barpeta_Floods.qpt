 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="1" id="" itemRotation="0" labelText="&lt;div style=&quot;font-family: 'Segoe UI', Arial, sans-serif; background-color: #fdfdfd; border: 1px solid #d1d5db; border-left: 6px solid #0056b3; padding: 12px 15px; border-radius: 6px; box-shadow: 2px 2px 5px rgba(0,0,0,0.05);&quot;>&#xa;  &lt;h3 style=&quot;margin: 0 0 10px 0; color: #1e3a8a; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e5e7eb; padding-bottom: 6px;&quot;>&#xa;    📊 Key Findings (Area in Sq. Km.)&#xa;  &lt;/h3>&#xa;  &lt;table style=&quot;width: 100%; font-size: 12px; line-height: 1.8; color: #374151; border-collapse: collapse;&quot;>&#xa;    &lt;tr>&#xa;      &lt;td style=&quot;padding: 2px 0;&quot;>&lt;b>2024 Flood Extent:&lt;/b>&lt;/td>&#xa;      &lt;td style=&quot;color: #dc2626; font-weight: bold; text-align: right;&quot;>353.11 Sq. Km.&lt;/td>&#xa;    &lt;/tr>&#xa;    &lt;tr>&#xa;      &lt;td style=&quot;padding: 2px 0;&quot;>&lt;b>2025 Flood Extent:&lt;/b>&lt;/td>&#xa;      &lt;td style=&quot;color: #0284c7; font-weight: bold; text-align: right;&quot;>281.98 Sq. Km.&lt;/td>&#xa;    &lt;/tr>&#xa;    &lt;tr style=&quot;border-top: 1px dashed #cccccc;&quot;>&#xa;      &lt;td style=&quot;padding-top: 6px;&quot;>&lt;b>Net Difference:&lt;/b>&lt;/td>&#xa;      &lt;td style=&quot;color: #16a34a; font-weight: bold; text-align: right; padding-top: 6px;&quot;>-71.13 Sq. Km. (~20% ↓)&lt;/td>&#xa;    &lt;/tr>&#xa;  &lt;/table>&#xa;  &lt;p style=&quot;margin: 10px 0 0 0; font-size: 9.5px; color: #6b7280; font-style: italic; background-color: #f3f4f6; padding: 5px; border-radius: 3px;&quot;>&#xa;    *Note: Analysis reflects post-monsoon waterlogging conditions as recorded on October 22.&#xa;  &lt;/p>&#xa;&lt;/div>" marginX="0" marginY="0" opacity="1" outlineWidthM="0.4,mm" position="6.70654,87.1952,mm" positionLock="false" positio